  "additionalProperties": false,
  "$defs": {
    "numeric": {
      "type": "object",
      "required": [
        "median",
        "mean",
        "scale"
      ],
      "properties": {
        "median": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "missing_training_rows": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "categorical": {
      "type": "object",
      "required": [
        "missing_code",
        "unknown_code",
        "vocabulary"
      ],
      "properties": {
        "missing_code": {
          "const": 0
        },
        "unknown_code": {
          "const": 1
        },
        "vocabulary": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 2
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Matches evaluation.build_model_metadata; no source paths or records are exported. Contiguous vocabulary codes, missing-row counts <= fit_rows, exact architecture/schema reconstruction and metadata_digest binding require create_model_from_metadata semantic validation."
