{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcfl:0.1.0:update-decision",
  "title": "Final update outcome and audit payload v0.1.0",
  "type": "object",
  "required": [
    "update_id",
    "org_id",
    "outcome",
    "reason",
    "evaluation_order",
    "observed_epoch",
    "history_digest",
    "manifest_ref"
  ],
  "properties": {
    "update_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "org_id": {
      "type": "string",
      "enum": [
        "org_01",
        "org_02",
        "org_03",
        "org_04",
        "org_05",
        "org_06",
        "org_07",
        "org_08"
      ]
    },
    "round_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "purpose": {
      "type": "string",
      "pattern": "\\S"
    },
    "start_order": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "error"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "evaluation_order": {
      "type": "integer",
      "minimum": 1
    },
    "observed_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "history_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "weights_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rule_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_query": {
      "anyOf": [
        {
          "$ref": "urn:pcfl:0.1.0:interval-query"
        },
        {
          "type": "null"
        }
      ]
    },
    "history_digest_scope": {
      "const": "organization"
    },
    "authorization_status": {
      "const": "not_evaluated_operational_error"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "start_order": {
            "type": "integer",
            "minimum": 1
          },
          "manifest_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "policy_decision_id"
        ]
      },
      "then": {
        "required": [
          "policy_query",
          "rule_bundle_hash",
          "history_digest_scope"
        ]
      }
    },
    {
      "if": {
        "required": [
          "authorization_status"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "round_id",
          "purpose",
          "start_order",
          "run_id",
          "rule_bundle_hash",
          "history_digest_scope",
          "policy_decision_id",
          "policy_query"
        ],
        "properties": {
          "outcome": {
            "const": "error"
          },
          "policy_decision_id": {
            "type": "null"
          },
          "policy_query": {
            "type": "null"
          },
          "manifest_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "policy_decision_id"
        ],
        "properties": {
          "policy_decision_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "authorization_status"
        ]
      }
    }
  ],
  "$comment": "Finality, one-outcome uniqueness, native OPA provenance and equality to the retained task/update/manifest require independent replay. Errors can reference unacknowledged tasks; accepted records cannot."
}
