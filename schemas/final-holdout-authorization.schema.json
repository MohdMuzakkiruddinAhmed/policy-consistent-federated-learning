{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcfl:0.1.0:final-holdout-authorization",
  "title": "Separately trusted final-holdout authorization v0.1.0",
  "type": "object",
  "required": ["schema_version", "kind", "authorization_id", "status", "scope", "issued_by", "issued_at_utc", "plan_digest", "test_sha256", "model_schema_hash", "runs", "authorization_digest"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "pcfl-final-holdout-authorization"},
    "authorization_id": {"$ref": "urn:pcfl:0.1.0:common#/$defs/id"},
    "status": {"const": "authorized"},
    "scope": {"const": "final-committed-model-only"},
    "issued_by": {"$ref": "urn:pcfl:0.1.0:common#/$defs/id"},
    "issued_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "plan_digest": {"$ref": "urn:pcfl:0.1.0:common#/$defs/hash"},
    "test_sha256": {"$ref": "urn:pcfl:0.1.0:common#/$defs/hash"},
    "model_schema_hash": {"$ref": "urn:pcfl:0.1.0:common#/$defs/hash"},
    "runs": {
      "type": "object", "minProperties": 1, "maxProperties": 300,
      "propertyNames": {"$ref": "urn:pcfl:0.1.0:common#/$defs/id"},
      "additionalProperties": {"$ref": "urn:pcfl:0.1.0:common#/$defs/id"}
    },
    "authorization_digest": {"$ref": "urn:pcfl:0.1.0:common#/$defs/hash"}
  },
  "additionalProperties": false,
  "$comment": "Shape is not authority. Semantic checks require a separately trusted pinned object, accepted frozen plan/source/images/training, exact canonical digest, model schema and shared test SHA, unique registered eligible cell mapping and actual timezone-aware timestamp. This object is not accepted from HTTP callers."
}
